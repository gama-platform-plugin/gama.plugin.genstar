Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Genstar
Bundle-SymbolicName: gama.plugin.genstar;singleton:=true
Bundle-Version: 2026.6.0.qualifier
Automatic-Module-Name: espacedev.gaml.extensions.genstar
Bundle-RequiredExecutionEnvironment: JavaSE-25
Require-Bundle: com.google.guava,
 gama.dependencies,gama.core;bundle-version="0.0.0",gama.annotations,
 gama.processor,gama.api
Bundle-ClassPath: .,
 lib/jackson-annotations-2.13.2.jar,
 lib/jackson-core-2.13.2.jar,
 lib/opencsv-2.3.jar,
 lib/jackson-databind-2.13.2.jar,
 lib/poi-ooxml-3.9.jar
Export-Package: com.fasterxml.jackson.annotation,
 com.fasterxml.jackson.databind,
 espacedev.gaml.extensions.genstar.generator,
 espacedev.gaml.extensions.genstar.localisation,
 espacedev.gaml.extensions.genstar.old,
 espacedev.gaml.extensions.genstar.statement,
 espacedev.gaml.extensions.genstar.type,
 espacedev.gaml.extensions.genstar.utils,
 org.apache.poi,
 org.apache.poi.ss.usermodel
Import-Package: gama.core.util.file,
 gama.dev,
 gama.gaml.operators,
 gama.gaml.statements,
 gaml.compiler.gaml,
 org.apache.commons.text.similarity
